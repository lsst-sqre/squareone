{
  "name": "@lsst-sqre/repertoire-client",
  "description": "Repertoire service discovery client for Rubin Science Platform",
  "version": "0.4.1",
  "private": true,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./hooks": {
      "types": "./src/hooks/index.ts",
      "default": "./src/hooks/index.ts"
    }
  },
  "files": [
    "src/**"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "clean": "rm -rf node_modules",
    "fetch-openapi": "curl -o openapi.json https://data.lsst.cloud/repertoire/openapi.json"
  },
  "dependencies": {
    "@lsst-sqre/api-client-core": "workspace:*",
    "zod": "^4.5.4"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5",
    "react": "^18 || ^19"
  },
  "devDependencies": {
    "zod-schema-faker": "^2.1.1",
    "@faker-js/faker": "^10.5.0",
    "@lsst-sqre/eslint-config": "workspace:*",
    "@lsst-sqre/tsconfig": "workspace:*",
    "@tanstack/react-query": "^5.90.20",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.18",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
