{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@lsst-sqre/tsconfig/base.json",
  "compilerOptions": {
    "module": "ESNext",
    "target": "ES2022",
    "lib": ["ES2022"],
    "moduleResolution": "bundler",
    "outDir": "./dist",
    "rootDir": "./src",
    "resolveJsonModule": true,
    // tsup's declaration build (rollup-plugin-dts) still injects `baseUrl`,
    // which TypeScript 6 reports as a deprecation error. Nothing in this
    // package relies on it. Drop this once the build no longer uses tsup or
    // tsup stops setting it; TypeScript 7 removes the option entirely.
    "ignoreDeprecations": "6.0"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}
