{
  "private": true,
  "scripts": {
    "localci": "node packages/repo-scripts/src/validate-docker-versions.js && node packages/repo-scripts/src/validate-pnpm-config.js && node packages/repo-scripts/src/validate-biome-schema.js && node packages/repo-scripts/src/validate-theme-tokens.js && node scripts/turbo-wrapper.js run biome:format:check prettier:yaml lint type-check test build && pnpm run biome:lint",
    "build": "node scripts/turbo-wrapper.js run build",
    "file-factory": "node packages/file-factory/dist/cli.js",
    "dev": "node scripts/turbo-wrapper.js run dev",
    "test": "node scripts/turbo-wrapper.js run test",
    "storybook": "node scripts/turbo-wrapper.js run storybook",
    "build-storybook": "node scripts/turbo-wrapper.js run build-storybook",
    "test-storybook": "node scripts/turbo-wrapper.js run test-storybook",
    "test-storybook:watch": "node scripts/turbo-wrapper.js run test-storybook:watch",
    "lint": "node scripts/turbo-wrapper.js run lint",
    "type-check": "node scripts/turbo-wrapper.js run type-check",
    "biome:lint": "biome lint . --max-diagnostics 500",
    "biome:format": "biome check . --write",
    "biome:format:check": "biome format .",
    "prettier:yaml": "prettier --check \"**/*.{yaml,yml}\"",
    "ci:publish": "node scripts/turbo-wrapper.js run build && changeset publish",
    "ci:version": "changeset version && pnpm install --no-frozen-lockfile",
    "turbo": "node scripts/turbo-wrapper.js",
    "build:local": "turbo run build",
    "docs": "uv run noxfile.py -s docs",
    "validate-docker": "node packages/repo-scripts/src/validate-docker-versions.js",
    "validate-pnpm": "node packages/repo-scripts/src/validate-pnpm-config.js",
    "validate-biome": "node packages/repo-scripts/src/validate-biome-schema.js",
    "validate-theme-tokens": "node packages/repo-scripts/src/validate-theme-tokens.js",
    "check-openapi-drift": "node packages/repo-scripts/src/check-openapi-drift.js",
    "prepare": "node -e \"try { require('husky').install() } catch (e) {if (e.code !== 'MODULE_NOT_FOUND') throw e}\" && node scripts/install-playwright.js"
  },
  "prettier": {
    "overrides": [
      {
        "files": [
          "*.yaml",
          "*.yml"
        ],
        "options": {
          "singleQuote": true,
          "tabWidth": 2,
          "printWidth": 80,
          "trailingComma": "none"
        }
      }
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.2",
    "@turbo/gen": "^2.10.12",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "husky": "^8.0.3",
    "lint-staged": "^13.2.3",
    "playwright": "^1.62.1",
    "prettier": "^2.8.8",
    "turbo": "2.10.12",
    "vite": "^7.3.6",
    "webpack": "^5.110.3"
  },
  "engines": {
    "node": "^24.21.0",
    "pnpm": ">=12.3.4 <13"
  },
  "packageManager": "pnpm@12.3.4+sha512.961aa41fb077da3a04a441d9f8e15ebc0c96da8ef710b2eb67bf9ee7cb0610eabd48f1fd85f51cffe73846785fa0f87c56a3a872a1d893f8446741b5cce45457"
}
